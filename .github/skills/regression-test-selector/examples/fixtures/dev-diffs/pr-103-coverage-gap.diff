+package com.psp.refund;
+
+import org.springframework.web.bind.annotation.*;
+import org.springframework.http.ResponseEntity;
+
+@RestController
+@RequestMapping("/api/v1/refunds")
+public class RefundController {
+
+    // PAY-309: Introduce Instant Refund endpoint
+    @PostMapping("/instant")
+    public ResponseEntity<RefundResult> processInstantRefund(@RequestBody InstantRefundRequest request) {
+        return ResponseEntity.ok(new RefundResult("REF_INSTANT_OK", request.getOriginalTxnId()));
+    }
+}
